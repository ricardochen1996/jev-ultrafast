# ═══════════════════════════════════════════════════════════════════════════
#  1. Decisions — JEV_ENABLED picks the mode
# ═══════════════════════════════════════════════════════════════════════════
# true  -> Jev decides. Fill in the "Jev" group.
# false -> a chat model decides instead: the inspector serves it on a loopback
#          endpoint for the session (see LLM_SERVER_PORT below), so the only
#          thing to configure is the text model group — no Jev key needed.
JEV_ENABLED=true

# ── Jev (required only when JEV_ENABLED=true) ──────────────────────────────
# Any endpoint that speaks the TypeSafe System One protocol works. The default
# is the hosted API; OpenCode's gateway serves the same protocol at
# https://opencode.ai/zen/v1/systemone
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
# Optional second System One endpoint, used when the first is out of quota (429 or 402).
# TYPESAFE_FALLBACK_URL=

# ── Text model (always required; it decides too when JEV_ENABLED=false) ────
# OpenAI-compatible endpoint. TYPE_TEXT asks it for the words to type; with Jev
# off it also picks the operation and the element, under the contract in
# jev_ultrafast/llm_endpoint.py
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL_API_KEY=
TEXT_MODEL=inception/mercury-2.5
# How to switch the endpoint's reasoning off: none | thinking-disabled | leave empty.
TEXT_MODEL_REASONING=none
# Optional extra headers for the text endpoint, as a JSON object.
# TEXT_MODEL_HEADERS={"x-opencode-session": "harness"}
# Characters of page text sent with each decision made by the chat model.
# LLM_PAGE_CHARS=4000

# ═══════════════════════════════════════════════════════════════════════════
#  2. Browser
# ═══════════════════════════════════════════════════════════════════════════
# Optional: attach to a Chrome that is already listening for remote debugging.
# Read the value from the browser's DevToolsActivePort file; it changes when Chrome restarts.
# BU_CDP_WS=ws://127.0.0.1:9222/devtools/browser/<id>

# ═══════════════════════════════════════════════════════════════════════════
#  3. Local server
# ═══════════════════════════════════════════════════════════════════════════
# Inspector port.
# TYPESAFE_DEMO_PORT=8766
# Where the chat-model decision endpoint listens when JEV_ENABLED=false.
# LLM_SERVER_PORT=8770
