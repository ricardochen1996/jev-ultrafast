# Any endpoint that speaks the TypeSafe System One protocol works. The default is the hosted API;
# OpenCode's gateway serves the same protocol at https://opencode.ai/zen/v1/systemone.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone

# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional extra headers for the text endpoint, as a JSON object.
# TEXT_MODEL_HEADERS={"x-opencode-session": "harness"}

# Optional: attach to a Chrome that is already listening for remote debugging.
# Read the value from the browser's DevToolsActivePort file; it changes when Chrome restarts.
# BU_CDP_WS=ws://127.0.0.1:9222/devtools/browser/<id>
